# ==============================================
# 生产环境变量模板
# 使用：cp deploy/.env.production.example server/.env
# 然后修改所有 CHANGE_ME 的值
# ==============================================

# ---- 数据库 ----
# 对应 docker-compose.prod.yml 里配的账号密码
DATABASE_URL="mysql://villa:CHANGE_ME_DB_PASSWORD@127.0.0.1:3306/villa_party"

# docker-compose.prod.yml 需要这几个变量（也可以单独写在 deploy/.env.db）
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_DATABASE=villa_party
MYSQL_USER=villa
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ---- JWT ----
# 生成命令：openssl rand -hex 32
JWT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARS
JWT_EXPIRES_IN=7d

# ---- 微信小程序 ----
WX_APPID=CHANGE_ME
WX_SECRET=CHANGE_ME

# ---- 微信支付 ----
WX_PAY_MCH_ID=CHANGE_ME
WX_PAY_API_KEY=CHANGE_ME
WX_PAY_NOTIFY_URL=https://your-domain.com/api/payment/notify

# ---- AI（硅基流动）----
AI_BASE_URL=https://api.siliconflow.cn/v1
AI_API_KEY=CHANGE_ME
AI_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
AI_TEXT_MODEL=Qwen/Qwen3-8B

# ---- 腾讯云 COS ----
# ⚠️ 之前暴露过的 key 必须先在腾讯云控制台禁用并重新生成
COS_SECRET_ID=CHANGE_ME
COS_SECRET_KEY=CHANGE_ME
COS_BUCKET=villa-party-1348746784
COS_REGION=ap-guangzhou
COS_DOMAIN=

# ---- 服务器 ----
PORT=3000
NODE_ENV=production
