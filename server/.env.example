# Database
DATABASE_URL="mysql://villa:your_password@localhost:3307/villa_party"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

# WeChat Mini Program
WX_APPID=your_appid
WX_SECRET=your_secret

# WeChat Pay
WX_PAY_MCH_ID=your_mch_id
WX_PAY_API_KEY=your_api_key
WX_PAY_NOTIFY_URL=https://your-domain.com/api/payment/notify

# AI - Silicon Flow (免费，兼容 OpenAI 格式)
# 注册地址: https://cloud.siliconflow.cn
AI_BASE_URL=https://api.siliconflow.cn/v1
AI_API_KEY=your_siliconflow_api_key
AI_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
AI_TEXT_MODEL=Qwen/Qwen3-8B

# Server
PORT=3000
