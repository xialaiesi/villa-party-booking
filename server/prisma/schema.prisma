generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ==================== 别墅相关 ====================

model Villa {
  id           BigInt   @id @default(autoincrement())
  name         String   @db.VarChar(100)
  description  String?  @db.Text
  address      String   @db.VarChar(255)
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  maxGuests    Int      @map("max_guests")
  bedrooms     Int      @default(1)
  area         Decimal? @db.Decimal(8, 2)
  basePrice    Decimal  @map("base_price") @db.Decimal(10, 2)
  weekendPrice Decimal  @map("weekend_price") @db.Decimal(10, 2)
  deposit      Decimal  @default(0) @db.Decimal(10, 2)
  discount3d   Decimal? @map("discount_3days") @db.Decimal(3, 2)
  discount5d   Decimal? @map("discount_5days") @db.Decimal(3, 2)
  discount7d   Decimal? @map("discount_7days") @db.Decimal(3, 2)
  coverImage   String?  @map("cover_image") @db.VarChar(500)
  tags         String?  @db.VarChar(255)
  status       Int      @default(1) @db.TinyInt
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  images     VillaImage[]
  facilities VillaFacility[]
  calendars  VillaCalendar[]
  orders     Order[]
  reviews    Review[]

  @@map("villa")
}

model VillaImage {
  id        BigInt @id @default(autoincrement())
  villaId   BigInt @map("villa_id")
  url       String @db.VarChar(500)
  sortOrder Int    @default(0) @map("sort_order")

  villa Villa @relation(fields: [villaId], references: [id], onDelete: Cascade)

  @@map("villa_image")
}

model Facility {
  id       BigInt  @id @default(autoincrement())
  name     String  @db.VarChar(50)
  icon     String? @db.VarChar(200)
  category String? @db.VarChar(50)

  villas VillaFacility[]

  @@map("facility")
}

model VillaFacility {
  villaId    BigInt @map("villa_id")
  facilityId BigInt @map("facility_id")

  villa    Villa    @relation(fields: [villaId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@id([villaId, facilityId])
  @@map("villa_facility")
}

model VillaCalendar {
  id      BigInt   @id @default(autoincrement())
  villaId BigInt   @map("villa_id")
  date    DateTime @db.Date
  price   Decimal  @db.Decimal(10, 2)
  status  Int      @default(1) @db.TinyInt

  villa Villa @relation(fields: [villaId], references: [id], onDelete: Cascade)

  @@unique([villaId, date])
  @@map("villa_calendar")
}

// ==================== 套餐相关 ====================

model Package {
  id           BigInt   @id @default(autoincrement())
  name         String   @db.VarChar(100)
  description  String?  @db.Text
  price        Decimal  @db.Decimal(10, 2)
  weekendPrice Decimal? @map("weekend_price") @db.Decimal(10, 2)
  holidayPrice Decimal? @map("holiday_price") @db.Decimal(10, 2)
  category     String?  @db.VarChar(50)
  image        String?  @db.VarChar(500)
  status       Int      @default(1) @db.TinyInt

  orderPackages OrderPackage[]

  @@map("package")
}

// ==================== 用户相关 ====================

model User {
  id        BigInt   @id @default(autoincrement())
  openid    String   @unique @db.VarChar(64)
  unionId   String?  @map("union_id") @db.VarChar(64)
  nickname  String?  @db.VarChar(50)
  avatar    String?  @db.VarChar(500)
  phone     String?  @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")

  orders  Order[]
  reviews Review[]

  @@map("user")
}

// ==================== 订单相关 ====================

model Order {
  id             BigInt    @id @default(autoincrement())
  orderNo        String    @unique @map("order_no") @db.VarChar(32)
  userId         BigInt    @map("user_id")
  villaId        BigInt    @map("villa_id")
  checkIn        DateTime  @map("check_in") @db.Date
  checkOut       DateTime  @map("check_out") @db.Date
  days           Int
  guests         Int
  villaAmount    Decimal   @map("villa_amount") @db.Decimal(10, 2)
  packageAmount  Decimal   @default(0) @map("package_amount") @db.Decimal(10, 2)
  discountRate   Decimal   @default(1.00) @map("discount_rate") @db.Decimal(3, 2)
  discountAmount Decimal   @default(0) @map("discount_amount") @db.Decimal(10, 2)
  totalAmount    Decimal   @map("total_amount") @db.Decimal(10, 2)
  depositAmount  Decimal   @default(0) @map("deposit_amount") @db.Decimal(10, 2)
  depositStatus  Int       @default(0) @map("deposit_status") @db.TinyInt
  status         Int       @default(0) @db.TinyInt
  contactName    String?   @map("contact_name") @db.VarChar(50)
  contactPhone   String?   @map("contact_phone") @db.VarChar(20)
  remark         String?   @db.Text
  cancelReason   String?   @map("cancel_reason") @db.VarChar(255)
  createdAt      DateTime  @default(now()) @map("created_at")
  paidAt         DateTime? @map("paid_at")
  confirmedAt    DateTime? @map("confirmed_at")

  user          User           @relation(fields: [userId], references: [id])
  villa         Villa          @relation(fields: [villaId], references: [id])
  orderPackages OrderPackage[]
  payments      Payment[]
  reviews       Review[]

  @@map("order")
}

model OrderPackage {
  id          BigInt  @id @default(autoincrement())
  orderId     BigInt  @map("order_id")
  packageId   BigInt  @map("package_id")
  packageName String  @map("package_name") @db.VarChar(100)
  price       Decimal @db.Decimal(10, 2)
  quantity    Int     @default(1)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  package Package @relation(fields: [packageId], references: [id])

  @@map("order_package")
}

// ==================== 支付相关 ====================

model Payment {
  id            BigInt    @id @default(autoincrement())
  orderId       BigInt    @map("order_id")
  transactionId String?   @map("transaction_id") @db.VarChar(64)
  amount        Decimal   @db.Decimal(10, 2)
  refundAmount  Decimal?  @default(0) @map("refund_amount") @db.Decimal(10, 2)
  type          Int       @db.TinyInt
  status        Int       @default(0) @db.TinyInt
  createdAt     DateTime  @default(now()) @map("created_at")
  paidAt        DateTime? @map("paid_at")

  order Order @relation(fields: [orderId], references: [id])

  @@map("payment")
}

// ==================== 评价相关 ====================

model Review {
  id        BigInt   @id @default(autoincrement())
  orderId   BigInt   @map("order_id")
  userId    BigInt   @map("user_id")
  villaId   BigInt   @map("villa_id")
  rating    Int      @db.TinyInt
  content   String?  @db.Text
  images    String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id])
  user  User  @relation(fields: [userId], references: [id])
  villa Villa @relation(fields: [villaId], references: [id])

  @@map("review")
}

// ==================== 管理员 ====================

model Admin {
  id        BigInt   @id @default(autoincrement())
  username  String   @unique @db.VarChar(50)
  password  String   @db.VarChar(255)
  nickname  String?  @db.VarChar(50)
  status    Int      @default(1) @db.TinyInt
  createdAt DateTime @default(now()) @map("created_at")

  @@map("admin")
}
